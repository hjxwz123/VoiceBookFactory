# 声书工坊 Docker 部署配置：复制为 .env 后修改。docker compose 会读取这个文件。

# ---- 部署哪个版本 ----
# 填写发布的版本号（见 GitHub Releases），升级或回滚时只改这里，再执行 docker compose up -d
VB_VERSION=0.1.0
# 对外端口
VB_PORT=8080
# 用户访问站点的地址（OAuth 回调、邮件和分享链接里会用到）
VB_PUBLIC_URL=https://voicebook.example.com

# ---- 必填的密钥（用 openssl rand -hex 32 生成）----
# 登录令牌签名密钥
VB_JWT_SECRET=
# 加密数据库里保存的 AI 平台 API Key；设置后不要再改，否则已保存的密钥无法解密
VB_SECRET_KEY=

# ---- 数据库 ----
POSTGRES_USER=voicebook
POSTGRES_PASSWORD=
POSTGRES_DB=voicebook

# ---- 首次启动创建的管理员（登录后台后请立即修改密码）----
VB_ADMIN_EMAIL=admin@example.com
VB_ADMIN_PASSWORD=

# ---- 可选 ----
# 后台任务并发数（配音、合成等）
VB_WORKERS=4
# 下载 Wikimedia / OpenGameArt 曲库时附在 User-Agent 里的联系方式（对方的机器人政策要求）
VB_BOT_CONTACT=
# 首次启动自动创建的大模型账号（也可以之后在管理后台添加）
VB_LLM_PROTOCOL=openai_chat
VB_LLM_BASE_URL=
VB_LLM_API_KEY=
VB_LLM_MODEL=

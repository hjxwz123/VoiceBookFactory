VB_ADDR=:8080
VB_PUBLIC_URL=http://localhost:8080
VB_DATA_DIR=./data
VB_DB_DRIVER=sqlite          # 生产用 postgres，并设置 VB_DB_DSN
# VB_DB_DSN=host=localhost port=5432 user=voicebook password=voicebook dbname=voicebook sslmode=disable
# 多实例时设置 Redis（单实例可不填）
# VB_REDIS_URL=redis://localhost:6379/0
VB_JWT_SECRET=change-me
VB_SECRET_KEY=change-me       # 加密供应商密钥
VB_ADMIN_EMAIL=admin@example.com
VB_ADMIN_PASSWORD=Admin@123456
VB_DEV=true                  # 生产设为 false，并且必须设置 VB_JWT_SECRET / VB_SECRET_KEY
# 可选：首次启动自动创建 LLM / ASR 账号（也可在管理后台配置）
VB_LLM_PROTOCOL=openai_chat   # openai_chat | openai_responses | anthropic
VB_LLM_BASE_URL=
VB_LLM_API_KEY=
VB_LLM_MODEL=
VB_ASR_BASE_URL=
VB_ASR_API_KEY=
